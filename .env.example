# PostgreSQL connection string (Neon or local PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Generate a long random secret: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="8801XXXXXXXXX"
# Used only by the seed script to create the first administrator
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeThisPassword123!"

# SSLCommerz payment gateway (sandbox by default)
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"
SSLCOMMERZ_SANDBOX="true"
EMAIL_FROM="NovaLoom <notifications@your-verified-domain.com>"
RESEND_API_KEY="re_your_resend_api_key"
