generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  DESIGNER
  SUPPORT
}
enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  DISCUSSION
  QUOTATION_SENT
  AWAITING_APPROVAL
  CONFIRMED
  IN_PROGRESS
  TESTING
  COMPLETED
  DELIVERED
  CANCELLED
}
enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  requests     ProjectRequest[]
  projects     Project[]
  messages     Message[] @relation("MessageSender")
  tickets      SupportTicket[]
  notifications Notification[]
  assignedTasks Task[] @relation("TaskAssignee")
  activityLogs ActivityLog[]
}

model ServiceCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  shortTitle  String
  description String
  icon        String
  accent      String
  image        String
  features    String[]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  demos       DemoProject[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DemoProject {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  categoryId   String
  category     ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  description  String
  image        String
  technologies String[]
  features     String[]
  demoUrl      String?
  featured     Boolean  @default(false)
  concept      Boolean  @default(true)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProjectRequest {
  id           String   @id @default(cuid())
  requestCode  String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  clientName   String
  email        String
  phone        String?
  businessName String?
  serviceSlugs String[]
  projectType  String?
  features     String[]
  title        String
  description  String
  referenceUrl String?
  deadline     String?
  communication String?
  status       RequestStatus @default(SUBMITTED)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  quotations   Quotation[]
  project      Project?
  messages     Message[]
  tickets      SupportTicket[]
  invoices     Invoice[]
}

model Quotation {
  id          String   @id @default(cuid())
  requestId   String
  request     ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scope       String
  deliverables String[]
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("BDT")
  timeline    String
  terms       String?
  expiresAt   DateTime?
  status      QuoteStatus @default(DRAFT)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      RequestStatus @default(CONFIRMED)
  requestId   String?  @unique
  request     ProjectRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  clientId    String
  client      User @relation(fields: [clientId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean @default(false)
  sortOrder   Int @default(0)
}

model Consultation {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  preferredAt DateTime
  timezone    String @default("Asia/Dhaka")
  method      String
  message     String?
  status      String @default("PENDING")
  createdAt   DateTime @default(now())
}


enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  requestId   String
  request     ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  currency    String        @default("BDT")
  dueAt       DateTime?
  status      InvoiceStatus @default(ISSUED)
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("BDT")
  provider        String        @default("SSLCOMMERZ")
  status          PaymentStatus @default(PENDING)
  tranId          String        @unique
  gatewayTranId   String?
  validationId    String?
  rawStatus       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model SupportTicket {
  id          String   @id @default(cuid())
  ticketNo    String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String?
  request     ProjectRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  subject     String
  message     String
  status      String   @default("OPEN")
  priority    String   @default("NORMAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id          String   @id @default(cuid())
  requestId   String
  request     ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  internal    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  body        String
  href        String?
  readAt      DateTime?
  createdAt   DateTime @default(now())
}

model Task {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  status       String   @default("TODO")
  priority     String   @default("NORMAL")
  dueAt        DateTime?
  assigneeId   String?
  assignee     User?    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  details     String?
  createdAt   DateTime @default(now())
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  company     String?
  role        String?
  content     String
  rating      Int      @default(5)
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
